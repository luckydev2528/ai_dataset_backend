# Optional overrides for ffmpeg/ffprobe binaries (defaults to vendored static builds)
# Set full paths if you want to use system-installed binaries instead
FFMPEG_PATH=
FFPROBE_PATH=

# Force compression regardless of file size threshold (true/false)
FORCE_VIDEO_COMPRESSION=false

# Backend upload performance tuning
# Treat files <= this size (bytes) as small; skip resumable for speed
SMALL_UPLOAD_FAST_PATH_BYTES=5242880
# Force resumable uploads (otherwise disabled for small files)
FORCE_RESUMABLE_UPLOAD=false
# Disable CRC validation (faster, but less integrity checking)
DISABLE_CRC_VALIDATION=false
# Enable or disable thumbnail generation (true/false)
ENABLE_THUMBNAILS=true

# Auth fast lookup timeout (ms). Fallback to decoded claims on timeout.
AUTH_FAST_LOOKUP_TIMEOUT_MS=1500
# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit this file with real values to version control

# ==============================================
# SERVER CONFIGURATION
# ==============================================
NODE_ENV=production
PORT=3001

# ==============================================
# SECURITY CONFIGURATION
# ==============================================
# JWT Configuration - REQUIRED: Generate strong secrets!
# Use: openssl rand -base64 32 for JWT_SECRET
# Use: openssl rand -base64 64 for REFRESH_TOKEN_SECRET
JWT_SECRET=REQUIRED_MINIMUM_32_CHARACTERS_STRONG_RANDOM_STRING
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=REQUIRED_MINIMUM_64_CHARACTERS_STRONG_RANDOM_STRING_DIFFERENT_FROM_JWT_SECRET
REFRESH_TOKEN_EXPIRES_IN=30d

