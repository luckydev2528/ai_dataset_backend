# ==============================================
# CORS CONFIGURATION
# ==============================================
# Comma-separated list of allowed origins
CORS_ORIGIN=https://yourapp.com,https://www.yourapp.com

# ==============================================
# RATE LIMITING CONFIGURATION
# ==============================================
# General rate limiting (15 minutes window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth endpoint rate limiting (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ==============================================
# SOCIAL AUTH CONFIGURATION
# ==============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Twitter OAuth 1.0a Configuration (Server-side only)
# Get these from https://developer.twitter.com
TWITTER_CONSUMER_KEY=your-twitter-consumer-key
TWITTER_CONSUMER_SECRET=your-twitter-consumer-secret

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ==============================================
# API CONFIGURATION
# ==============================================
# Base URL for your API (used for Twitter OAuth callbacks)
# For React Native development with Android emulator: use your machine's IP
# Development: http://localhost:3000 (for web) or http://YOUR_IP:3000 (for mobile)
# Production: https://yourdomain.com
API_BASE_URL=http://localhost:3000

# Alternative for React Native (requires Twitter Developer Console update):
# API_BASE_URL=http://192.168.18.95:3000

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=drr:
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# ==============================================
# DATABASE CONFIGURATION (if needed)
# ==============================================
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=info
LOG_FORMAT=combined

# ==============================================
# SECURITY HEADERS
# ==============================================
# Additional security configurations can be added here

# ==============================================
# MONITORING & LOGGING CONFIGURATION
# ==============================================
# Logging configuration
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Health check configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# ==============================================
# CACHE CONFIGURATION
# ==============================================
# Cache TTL settings (in seconds)
CACHE_USER_TTL=3600
CACHE_FIREBASE_USER_TTL=1800
CACHE_API_RESPONSE_TTL=300
CACHE_CONFIG_TTL=7200

# ==============================================
# SESSION CONFIGURATION
# ==============================================
# Session management
SESSION_SECRET=your-session-secret-here
SESSION_COOKIE_MAX_AGE=86400000
SESSION_CLEANUP_INTERVAL=3600000

# ==============================================
# EMAIL CONFIGURATION (if needed)
# ==============================================
# SMTP configuration for sending emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=noreply@yourapp.com

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
# File upload settings
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# ==============================================
# PRODUCTION SECURITY CHECKLIST
# ==============================================
# 1. Change all default secrets and keys
# 2. Use strong, unique passwords (32+ characters)
# 3. Enable HTTPS only in production
# 4. Set NODE_ENV=production
# 5. Configure proper CORS origins
# 6. Review and adjust rate limits
# 7. Set up proper logging and monitoring
# 8. Use environment-specific Firebase projects
# 9. Regularly rotate secrets and keys
# 10. Enable proper backup and recovery procedures
# 11. Configure Redis with authentication
# 12. Set up proper error tracking
# 13. Enable request/response logging
# 14. Configure proper CORS policies
# 15. Set up monitoring and alerting